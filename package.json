{
  "name": "openeo-job-registry-elastic-api",
  "version": "0.0.0-semver",
  "description": "API to report OpenEO jobs",
  "author": "VITO",
  "private": false,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start | pino-pretty",
    "start:dev": "nest start --watch | pino-pretty",
    "start:debug": "nest start --debug --watch | pino-pretty",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "[ \"$NODE_ENV\" = production ] && exit 0; husky install",
    "release": "semantic-release"
  },
  "dependencies": {
    "@elastic/elasticsearch": "~9.5.1",
    "@nestjs/axios": "^1.0.0",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^9.1.6",
    "@nestjs/core": "^9.1.6",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-express": "^9.1.6",
    "@nestjs/swagger": "^6.1.2",
    "@nestjs/terminus": "^9.1.4",
    "@nestjs/throttler": "^6.2.1",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "commit-analyzer-fail-on-no-release": "^1.0.1",
    "convict": "^6.2.3",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^16.0.3",
    "express-session": "^1.17.3",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.1.0",
    "openid-client": "^5.2.1",
    "passport": "^0.6.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "semantic-release": "^19.0.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@nestjs/cli": "^9.1.5",
    "@nestjs/schematics": "^9.0.3",
    "@nestjs/testing": "^9.1.6",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.5",
    "@types/jest": "29.5.14",
    "@types/node": "^16.0.0",
    "@types/openid-client": "^3.7.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.1",
    "jest": "^29.7.0",
    "lint-staged": "^13.0.3",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "coveragePathIgnorePatterns": [
      ".module.ts",
      ".dto.ts",
      "health.",
      ".schema.ts",
      ".enum.ts",
      ".decorator.ts",
      "main.ts",
      "bearer.guard",
      ".mock.ts",
      ".middleware.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
